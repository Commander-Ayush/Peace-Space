<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdf_container_view" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface">
    <androidx.core.widget.NestedScrollView android:id="@+id/home_content" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:padding="24dp" android:paddingBottom="104dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peace Space" android:textAppearance="?attr/textAppearanceHeadlineLarge"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your reading, one word at a time." android:textAppearance="?attr/textAppearanceBodyLarge"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/appearance_settings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Explanation appearance" app:icon="@drawable/ic_palette"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Recent documents" android:textAppearance="?attr/textAppearanceTitleLarge"/>
            <TextView android:id="@+id/recent_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Open your first PDF using the folder icon below. Your last 99 documents will appear here." android:textAppearance="?attr/textAppearanceBodyLarge"/>
            <LinearLayout android:id="@+id/recent_documents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout android:id="@+id/fragment_container_view" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
    <LinearLayout android:id="@+id/reading_controls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="16dp" android:orientation="horizontal" android:background="@drawable/explanation_surface" android:padding="4dp" android:elevation="8dp">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/home_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:layout_margin="2dp" android:background="@drawable/icon_control" android:contentDescription="Recent documents" app:srcCompat="@drawable/ic_home" app:tint="?attr/colorOnSecondaryContainer"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/launch_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:layout_margin="2dp" android:background="@drawable/icon_control" android:contentDescription="Open PDF" app:srcCompat="@drawable/ic_open" app:tint="?attr/colorOnSecondaryContainer"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/search_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:layout_margin="2dp" android:background="@drawable/icon_control" android:contentDescription="Search in document" app:srcCompat="@drawable/ic_search" app:tint="?attr/colorOnSecondaryContainer"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/history_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:layout_margin="2dp" android:background="@drawable/icon_control" android:contentDescription="Word history and recording settings" app:srcCompat="@drawable/ic_history" app:tint="?attr/colorOnSecondaryContainer"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/appearance_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:layout_margin="2dp" android:background="@drawable/icon_control" android:contentDescription="Explanation appearance" app:srcCompat="@drawable/ic_palette" app:tint="?attr/colorOnSecondaryContainer"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/more_button" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:layout_margin="12dp" android:padding="15dp" android:background="@drawable/more_control" android:contentDescription="Reading actions" android:visibility="gone" app:srcCompat="@drawable/ic_more" app:tint="?attr/colorOnSecondaryContainer"/>
</FrameLayout>
